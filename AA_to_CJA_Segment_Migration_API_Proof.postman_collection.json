    {
      "name": "02 - Adobe Component Migration Proof",
      "description": "Shows the completed migration status. The submit request is locked and is present only to document the API payload used.",
      "item": [
        {
          "name": "01 - Completed Migration Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-api-key",
                "value": "{{client_id}}",
                "type": "text"
              },
              {
                "key": "x-gw-ims-org-id",
                "value": "{{org_id}}",
                "type": "text"
              }
            ],
            "url": "{{aa_base_url}}/api/{{global_company_id}}/cjamigration/projects/{{aa_project_id}}/summary",
            "description": "Official Adobe Component Migration summary for the completed POC migration."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Migration summary returned\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"migration_status\", String(json.migrationStatus || \"\"));",
                  "pm.collectionVariables.set(\"migrated_segment_count\", String(json.result?.mapped?.segments?.length || 0));",
                  "pm.test(\"Migration is completed\", () => pm.expect(json.migrationStatus).to.eql(\"COMPLETED\"));",
                  "pm.test(\"Migrated CJA project matches\", () => pm.expect(json.cjaId).to.eql(pm.variables.get(\"cja_migrated_project_id\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - DO NOT RUN - Migration Submit (Protected Reference)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-api-key",
                "value": "{{client_id}}",
                "type": "text"
              },
              {
                "key": "x-gw-ims-org-id",
                "value": "{{org_id}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aaId\": \"{{aa_project_id}}\",\n  \"globalCompanyId\": \"{{global_company_id}}\",\n  \"imsOrgId\": \"{{org_id}}\",\n  \"imsUserId\": \"{{migration_owner_ims_user_id}}\",\n  \"imsUserName\": \"{{migration_owner_name}}\",\n  \"rsidDataIdMap\": {\n    \"{{aa_source_rsid}}\": \"{{cja_data_view_id}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{aa_base_url}}/api/{{global_company_id}}/cjamigration/projects",
            "description": "Protected reference only. This POC migration is already complete. Do not run it again. For a separately approved new migration, update every ID, complete preflight validation and deliberately set run_migration=true."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get(\"run_migration\") !== \"true\") {",
                  "  throw new Error(\"Safety stop: the POC migration is already complete. Keep run_migration=false.\");",
                  "}",
                  "if (!pm.variables.get(\"migration_owner_ims_user_id\") || !pm.variables.get(\"migration_owner_name\")) {",
                  "  throw new Error(\"Migration owner values are required for an approved new migration.\");",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
