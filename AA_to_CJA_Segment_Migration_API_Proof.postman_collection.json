{
  "info": {
    "_postman_id": "8c0ef9a0-2861-47d2-b76c-1d18d27ff5d9",
    "name": "AA to CJA Segment Migration - API Proof",
    "description": "Evidence package for the completed Adobe Analytics to Customer Journey Analytics segment migration POC.\n\nRun 00 Authentication first, followed by the read-only folders in order. The collection shows the Adobe Analytics inventory, source segment and project, completed Adobe migration summary, CJA readback, copied-segment readback, and sharing verification.\n\nThe migration POST is retained only as a protected reference. It is blocked unless run_migration is deliberately changed to true for a separately approved migration.\n\nNo client secret or access token is stored in this export. Adobe component IDs are included as POC evidence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const required = [\"client_id\", \"org_id\"];",
          "const missing = required.filter((key) => !pm.variables.get(key));",
          "if (!pm.request.url.toString().includes(\"adobelogin.com\") && missing.length) {",
          "  throw new Error(`Missing environment values: ${missing.join(\", \")}`);",
          "}"
        ]
      }
    }
  ],
