    {
      "name": "04 - Segment Sharing Proof",
      "description": "Read-only verification that the API-owned copy is shared to one user and is not shared to all.",
      "item": [
        {
          "name": "01 - Verify Copied Segment Share",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-api-key",
                "value": "{{client_id}}",
                "type": "text"
              },
              {
                "key": "x-gw-ims-org-id",
                "value": "{{org_id}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"componentType\": \"segment\",\n  \"componentIds\": [\n    \"{{cja_shared_copy_segment_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{cja_base_url}}/componentmetadata/shares/component/search?page=0&limit=100",
            "description": "Searches sharing metadata for only the copied segment. This is a read-only search even though Adobe exposes it as POST."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Share search returned\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const records = Array.isArray(json) ? json : (json.content || []);",
                  "const record = records.find((item) => item.componentId === pm.variables.get(\"cja_shared_copy_segment_id\"));",
                  "const shares = record?.shares || [];",
                  "pm.collectionVariables.set(\"copy_share_count\", String(shares.length));",
                  "pm.test(\"Copied segment has a user share\", () => pm.expect(shares.some((share) => share.shareToType === \"user\")).to.be.true);",
                  "pm.test(\"Copied segment is not shared to all\", () => pm.expect(shares.some((share) => share.shareToType === \"all\")).to.be.false);",
                  "pm.visualizer.set(`",
                  "<style>body{font-family:Arial,sans-serif;color:#222;padding:18px}h1{font-size:22px;margin:0 0 16px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{border:1px solid #ddd;border-radius:8px;padding:14px}.value{font-size:24px;font-weight:700;margin-top:6px}.ok{color:#18794e}.note{margin-top:18px;font-size:13px;color:#555}</style>",
                  "<h1>AA to CJA Segment Migration - Evidence Summary</h1>",
                  "<div class=\"grid\">",
                  "<div class=\"card\">AA API-visible segments<div class=\"value\">{{aaTotal}}</div></div>",
                  "<div class=\"card\">CJA API-visible segments<div class=\"value\">{{cjaTotal}}</div></div>",
                  "<div class=\"card\">Migration status<div class=\"value ok\">{{status}}</div></div>",
                  "<div class=\"card\">Segments mapped in project<div class=\"value\">{{mappedSegments}}</div></div>",
                  "<div class=\"card\">Copied segment shares<div class=\"value\">{{shareCount}}</div></div>",
                  "<div class=\"card\">Copy shared to all<div class=\"value ok\">No</div></div>",
                  "</div>",
                  "<div class=\"note\">Counts reflect the permissions of the OAuth technical account. UI visibility depends on ownership and sharing.</div>",
                  "` , {",
                  "  aaTotal: pm.collectionVariables.get(\"aa_total_segments\") || \"Run folder 01\",",
                  "  cjaTotal: pm.collectionVariables.get(\"cja_total_segments\") || \"Run request 03.05\",",
                  "  status: pm.collectionVariables.get(\"migration_status\") || \"Run request 02.01\",",
                  "  mappedSegments: pm.collectionVariables.get(\"migrated_segment_count\") || \"Run request 02.01\",",
                  "  shareCount: String(shares.length),",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
