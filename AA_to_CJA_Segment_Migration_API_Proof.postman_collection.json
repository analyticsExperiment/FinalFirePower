  "item": [
    {
      "name": "00 - Authentication",
      "description": "Generate a fresh Adobe OAuth Server-to-Server token. The token is stored only in the active Postman collection variable for this session.",
      "item": [
        {
          "name": "00 - Generate Server-to-Server Access Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "{{scopes}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{adobe_token_url}}",
            "description": "Uses the existing Adobe Developer Console OAuth Server-to-Server credential. Keep the client secret only in a local Postman environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token request succeeded\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Access token returned\", () => pm.expect(json.access_token).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"access_token\", json.access_token);",
                  "pm.collectionVariables.set(\"access_token\", json.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Adobe Analytics Source Evidence",
      "description": "Read-only proof of the Adobe Analytics inventory and the exact source segment/project selected for migration.",
      "item": [
        {
          "name": "01 - AA Segment Inventory and Total Count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-api-key",
                "value": "{{client_id}}",
                "type": "text"
              },
              {
                "key": "x-gw-ims-org-id",
                "value": "{{org_id}}",
                "type": "text"
              }
            ],
            "url": "{{aa_base_url}}/api/{{global_company_id}}/segments?page=0&limit=100&includeType=all&filterByPublishedSegments=all&expansion=reportSuiteName,ownerFullName,modified,compatibility",
            "description": "Returns the first page and the tenant-visible total segment count. This can be higher than the number visible in the current UI because API and UI visibility depend on access, owner and report-suite filters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"AA inventory returned\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"aa_total_segments\", String(json.totalElements ?? (json.content || []).length));",
                  "console.log(\"AA visible segment count:\", pm.collectionVariables.get(\"aa_total_segments\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Source Segment Definition",
          "request": {
